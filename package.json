{
  "name": "reindeer",
  "version": "1.0.1",
  "description": "A reindeer-shaped visualization component for mapping sales activities and opportunities over time",
  "license": "Unlicense",
  "author": "Mark Townsend",
  "repository": {
    "type": "git",
    "url": "https://github.com/markstownsend/reindeer.git"
  },
  "keywords": [
    "visualization",
    "d3",
    "react",
    "chart",
    "timeline",
    "sales",
    "opportunities",
    "svg"
  ],
  "homepage": "https://github.com/markstownsend/reindeer",
  "bugs": {
    "url": "https://github.com/markstownsend/reindeer/issues"
  },
  "type": "module",
  "main": "./dist/reindeer.js",
  "module": "./dist/reindeer.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "import": "./dist/reindeer.js",
      "types": "./dist/lib.d.ts"
    },
    "./styles.css": "./dist/reindeer.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "pack:local": "npm run build:lib && npm pack"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "baseline-browser-mapping": "^2.11.23",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
